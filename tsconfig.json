{
  // Compiles src/ (TS, .ts-relative imports) to lib/ (ESM JS + .d.ts).
  // @deepseek-ai/* stay bare specifiers and resolve at runtime from the host.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "jsx": "react-jsx",
    "types": ["node", "react"]
  },
  "include": ["src"],
  "exclude": []
}
